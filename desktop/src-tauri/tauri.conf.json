{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Best Photo Picker",
  "mainBinaryName": "Best Photo Picker",
  "version": "0.1.0",
  "identifier": "com.arkalogy.bpp",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5001",
    "beforeBuildCommand": "",
    "beforeDevCommand": "pkill -f 'bpp serve' 2>/dev/null; sleep 0.5; cd .. && .venv/bin/bpp serve --library ~/Pictures/BestPhotoPicker --no-browser"
  },
  "app": {
    "windows": [
      {
        "title": "Best Photo Picker",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' http://localhost:5001 ws://localhost:5001; font-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/bpp-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
