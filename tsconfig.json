{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "tests-js/**/*.mjs",
    "tests-js/types/**/*.d.ts",
    "scripts/**/*.mjs",
    "eslint.config.js",
    "vitest.config.mjs"
  ],
  "exclude": ["node_modules", "desktop", ".venv"]
}
