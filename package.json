{
  "name": "best-photo-picker-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Frontend dev tooling (lint + test) for the bpp web UI. Runtime JS is loaded directly from bpp/web/static/js/ via <script> tags — no build step.",
  "type": "module",
  "scripts": {
    "lint:globals": "node scripts/generate-eslint-globals.mjs",
    "lint": "npm run lint:globals && eslint bpp/web/static/js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:js": "vitest run",
    "test:js:coverage": "vitest run --coverage",
    "test:js:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:list": "playwright test --list",
    "test:e2e:synthetic": "bash scripts/run_e2e.sh synthetic",
    "test:e2e:empty": "bash scripts/run_e2e.sh empty",
    "test:e2e:demo": "bash scripts/run_e2e.sh demo",
    "test:e2e:ci": "bash scripts/run_e2e.sh ci",
    "test:e2e:all": "bash scripts/run_e2e.sh all"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
